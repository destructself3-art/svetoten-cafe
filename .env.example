# Local SQLite database (path is relative to the project root)
DATABASE_URL="file:./prisma/dev.db"

# Admin panel password and the secret that signs the admin session cookie.
# Change both before deploying anywhere public.
ADMIN_PASSWORD="svetoten"
ADMIN_SECRET="change-me-to-a-long-random-string"

# Optional: new bookings are sent to this Telegram chat when both values are set.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Portfolio demo: fills the next two weeks with believable bookings so the floor plan and admin never look empty.
# Set to "false" for a real café.
DEMO_BOOKINGS="true"

# Public URL, used for social previews
SITE_URL="http://localhost:3100"
